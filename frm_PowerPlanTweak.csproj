  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Release builds only: merge Guna.UI2.dll into the exe with ILRepack so distribution is a single
    file. Debug builds are left unmerged (faster iteration, matching PDBs). ILRepack can't write to
    one of its own input files, so it targets a temp file that then replaces the original.
  -->
  <Target Name="MergeAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ILRepackExe>$(MSBuildProjectDirectory)\tools\ILRepack\bin\ILRepack.exe</ILRepackExe>
      <MergedExe>$(TargetDir)$(TargetFileName)</MergedExe>
      <MergedExeTmp>$(TargetDir)$(AssemblyName).merged.exe</MergedExeTmp>
      <MergedPdbTmp>$(TargetDir)$(AssemblyName).merged.pdb</MergedPdbTmp>
      <MergedConfigTmp>$(TargetDir)$(AssemblyName).merged.exe.config</MergedConfigTmp>
      <GunaDll>$(TargetDir)Guna.UI2.dll</GunaDll>
      <MergeHappened>false</MergeHappened>
      <MergeHappened Condition="Exists('$(GunaDll)')">true</MergeHappened>
    </PropertyGroup>
    <Exec Command="&quot;$(ILRepackExe)&quot; /target:winexe /out:&quot;$(MergedExeTmp)&quot; &quot;$(MergedExe)&quot; &quot;$(GunaDll)&quot;" WorkingDirectory="$(TargetDir)" Condition="'$(MergeHappened)' == 'true'" />
    <Move SourceFiles="$(MergedExeTmp)" DestinationFiles="$(MergedExe)" Condition="'$(MergeHappened)' == 'true'" />
    <Move SourceFiles="$(MergedPdbTmp)" DestinationFiles="$(TargetDir)$(AssemblyName).pdb" Condition="'$(MergeHappened)' == 'true' And Exists('$(MergedPdbTmp)')" />
    <Delete Files="$(GunaDll);$(MergedConfigTmp)" Condition="'$(MergeHappened)' == 'true'" />
  </Target>
